{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "AccessMinutes": 60,
    "RefreshDays": 30,
    "Issuer": "hidrix-api",
    "Audience": "hidrix-app"
  },
  "Auth": {
    "RequireEmailConfirmation": false,
    "AutoConfirmEmailInDevelopment": true
  },
  "Health": {
    "DetailedKey": ""
  },
  "Visualiti": {
    "Enabled": true,
    "BaseUrl": "https://api.appgricultor.com",
    "LoginUrl": "",
    "ApiUrl": "",
    "Cliente": "AGROSAVIA",
    "Usuario": "",
    "Password": "",
    "SslVerify": false,
    "MetaCacheSeconds": 600,
    "InventoryCacheSeconds": 600,
    "StaleInventoryMaxMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8100",
      "http://127.0.0.1:8100",
      "http://localhost:8200",
      "http://127.0.0.1:8200",
      "https://hidrix.ngrok.app"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "HidrtbLog",
            "schemaName": "dbo",
            "autoCreateSqlTable": true,
            "batchPostingLimit": 50,
            "batchPeriod": "00:00:05"
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Hidrix.Api"
    }
  },
  "AllowedHosts": "*"
}
