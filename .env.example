# Plantilla de secretos / configuración sensible para ws-hidrix.
# Copiar a .env (NO versionar) y completar valores reales:
#   cp .env.example .env
#
# ASP.NET Core lee estas variables automáticamente (también User Secrets en Development).
# Formato: Section__Key  (doble guion bajo = anidación JSON)

# SQL Server (debe coincidir con docker-compose / SA del contenedor)
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=dbHidrix;User Id=sa;Password=CAMBIAR_SA_PASSWORD;TrustServerCertificate=True;Encrypt=False

# JWT (mínimo ~32 caracteres en producción)
Jwt__Secret=CAMBIAR_JWT_SECRET_MIN_32_CHARS
Jwt__AccessMinutes=60
Jwt__RefreshDays=30
Jwt__Issuer=hidrix-api
Jwt__Audience=hidrix-app

# Auth (producción: RequireEmailConfirmation=true)
Auth__RequireEmailConfirmation=false
Auth__AutoConfirmEmailInDevelopment=true

# Health: clave para ver detalle de BD (header X-Health-Key)
Health__DetailedKey=

# Visualiti (humedad en vivo) — host unificado api.appgricultor.com
Visualiti__Enabled=true
Visualiti__BaseUrl=https://api.appgricultor.com
# Opcional: si se dejan vacíos, se derivan de BaseUrl
Visualiti__LoginUrl=
Visualiti__ApiUrl=
Visualiti__Cliente=AGROSAVIA
Visualiti__Usuario=CAMBIAR_USUARIO
Visualiti__Password=CAMBIAR_PASSWORD
Visualiti__SslVerify=false
Visualiti__MetaCacheSeconds=600
Visualiti__InventoryCacheSeconds=600
Visualiti__StaleInventoryMaxMinutes=60

# Usuario admin sembrado al iniciar (se crea o se promueve a rol Admin si ya existe).
# Opcional: si se deja vacío/sin definir, no se siembra ningún admin.
Seed__AdminEmail=
Seed__AdminPassword=
