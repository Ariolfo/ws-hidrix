# Plantilla de variables de entorno de RUNTIME para Azure Container Apps (ws-yarqua).
#
# Este archivo es solo referencia: NO se copia dentro de la imagen Docker
# (excluido vía .dockerignore) y NO lo lee la app directamente. Sirve para:
#   1) copiarlo a `.env.azure`, completarlo con los valores reales de Azure, y
#   2) que `scripts/deploy-azure.sh` lo use para crear los secrets/env vars del
#      Container App (o para configurarlos a mano con `az containerapp update`).
#
# Formato: Section__Key (doble guion bajo = anidación de appsettings.json),
# igual que en `.env` / `.env.example` para desarrollo local.
#
#   cp .env.azure.example .env.azure   # completar y NO versionar
#
# IMPORTANTE: este archivo lo carga scripts/deploy-azure.sh con `source` (bash),
# no con un parser de .env:
#   - Todo valor con espacios, ';', '$', '`' o '!' DEBE ir entre comillas
#     simples '...' (por eso el connection string y las passwords las llevan).
#   - NUNCA uses placeholders con '<' o '>' sin comillas: bash los interpreta
#     como redirección de archivo. Por eso los placeholders de abajo son
#     CAMBIAR_XXX en vez de <xxx>.

# --- Base de datos: Azure SQL Database ---
# Azure SQL exige TLS. Encrypt=True es obligatorio; TrustServerCertificate=False
# porque el certificado de *.database.windows.net ya es público y válido.
ConnectionStrings__DefaultConnection='Server=tcp:CAMBIAR_SQL_SERVER.database.windows.net,1433;Database=CAMBIAR_SQL_DB;User Id=CAMBIAR_SQL_ADMIN_USER;Password=CAMBIAR_SQL_ADMIN_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30'

# --- ASP.NET Core ---
# El Dockerfile ya define estos por defecto; solo inclúyelos si necesitas
# sobreescribirlos en el Container App.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- JWT ---
# Genera un secreto nuevo y fuerte para producción (no reutilices el de .env local).
# Ejemplo: openssl rand -base64 48
Jwt__Secret='CAMBIAR_JWT_SECRET_MIN_32_CHARS'
Jwt__AccessMinutes=60
Jwt__RefreshDays=30

# --- Visualiti (API externa de humedad, la misma que en .env local) ---
Visualiti__Enabled=true
Visualiti__LoginUrl=http://appgricultor.com/api/login
Visualiti__ApiUrl=https://api.appgricultor.com
Visualiti__Cliente=AGROSAVIA
Visualiti__Usuario='CAMBIAR_VISUALITI_USUARIO'
Visualiti__Password='CAMBIAR_VISUALITI_PASSWORD'
Visualiti__SslVerify=false

# --- Datos de aprovisionamiento (los usa scripts/deploy-azure.sh, no la app) ---
# Nombres de los recursos de Azure a crear/usar. Ajusta a tu convención.
AZ_RESOURCE_GROUP=rg-yarqua-prod
AZ_LOCATION=eastus2
AZ_SQL_SERVER_NAME=CAMBIAR_SQL_SERVER
AZ_SQL_DB_NAME=CAMBIAR_SQL_DB
AZ_SQL_ADMIN_USER='CAMBIAR_SQL_ADMIN_USER'
AZ_SQL_ADMIN_PASSWORD='CAMBIAR_SQL_ADMIN_PASSWORD'
AZ_ACR_NAME=CAMBIAR_ACR_NAME
AZ_CONTAINERAPPS_ENV=yarqua-env
AZ_CONTAINERAPP_NAME=yarqua-api
# Opcional: nombre de la imagen en el registry. Si se omite, usa AZ_CONTAINERAPP_NAME.
# AZ_IMAGE_NAME=yarqua-api
